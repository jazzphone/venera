# What Venera is built from that isn't in this repository: one line each, KEY=VALUE, sourced by the build scripts
# (vm/opencore/build.sh, hostvideo, tools/make-sources.sh), which check each download against its SHA256. A copy of
# each is in every release's Venera-sources-VERSION.tar (tools/make-sources.sh), so a release rebuilds offline even
# if an upstream goes away. Change a version here, and its checksum, together.

# acidanthera's OpenCorePkg (BSD-3): the OpenCore image, macrecovery.py
OPENCORE_VERSION=1.0.8
OPENCORE_URL=https://github.com/acidanthera/OpenCorePkg/releases/download/1.0.8/OpenCore-1.0.8-RELEASE.zip
OPENCORE_SHA256=2011e8b7216ecb2645d97ea710df965947edd406846e92050b9bc4190be6d27b

# Mesa (MIT): the Venus Vulkan driver in the Metal bundle, with mesa/patches
MESA_VERSION=25.0.7
MESA_URL=https://archive.mesa3d.org/mesa-25.0.7.tar.xz
MESA_SHA256=592272df3cf01e85e7db300c449df5061092574d099da275d19e97ef0510f8a6

# FFmpeg (LGPL-2.1, built without GPL or nonfree parts): the host video service's libraries
FFMPEG_VERSION=7.1.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-7.1.1.tar.xz
FFMPEG_SHA256=733984395e0dbbe5c046abda2dc49a5544e7e0e1e2366bba849222ae9e3a03b1

# NullMoth's nvidia-macos-driver (translator/: LGPL-3.0-or-later): the Metal shader translator, built from wrapper/
TRANSLATOR_REPO=https://github.com/nullmoth/nvidia-macos-driver
TRANSLATOR_COMMIT=87e524a
# the Rust it was built with (Homebrew's, std built with -Z build-std): a different one warns
TRANSLATOR_RUSTC=1.99.1

# Debian for the host video build and the OpenCore image build (pinned by digest)
DEBIAN_IMAGE=debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Venera's watcher (packaging/venera-watch.sh): keeps the Metal driver where every process can load it, at boot,
     every 30 minutes, and when its folders change. Installed by install.sh, removed by uninstall.sh. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.venera.watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Library/Application Support/Venera/venera-watch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>1800</integer>
	<key>WatchPaths</key>
	<array>
		<string>/System/Library/Extensions/VirtioGPUMetal.bundle</string>
		<string>/Library/GPUBundles</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Library/Application Support/Venera/watch.log</string>
</dict>
</plist>

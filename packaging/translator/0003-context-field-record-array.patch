+                    && matches!(instruction.operands[2], Operand::IdRef(element) if !constants.contains(&element))
+            }),
+        "the run-time index steps to its record: {asm}"
+    );
+    if std::process::Command::new("spirv-val")
+        .arg("--version")
+        .output()
+        .is_ok()
+    {
+        tools::spirv_val_bytes(&spv, &tmp).expect("spirv-val");
+    }
+    let _ = std::fs::remove_dir_all(tmp);

+#[test]
+fn native_record_buffer_read_back_from_a_context_field_is_an_array_of_records() {
+    // The entry keeps its buffer pointers in a local context struct and a helper reads one back, then reads record
+    // `idx[0]` of it and, through element 0, a member of record 0. With the buffer's struct_type_info declared, the
+    // declared struct alone was taken for the whole buffer, and the run-time element index became a struct member index.
+    let ll = r#"
+target triple = "air64-apple-macosx14.0.0"
+%Seg = type { <4 x float>, <4 x float>, <2 x float>, [8 x i8] }
+%Ctx = type { ptr addrspace(1), ptr addrspace(1) }
+
+define <4 x float> @frag(<4 x float> %position, ptr addrspace(1) "air-buffer-no-alias" %segs, ptr addrspace(1) "air-buffer-no-alias" %idx) {
+entry:
+  %ctx = alloca %Ctx, align 8
+  %segs_field = getelementptr inbounds %Ctx, ptr %ctx, i64 0, i32 0
+  store ptr addrspace(1) %segs, ptr %segs_field, align 8
+  %idx_field = getelementptr inbounds %Ctx, ptr %ctx, i64 0, i32 1
+  store ptr addrspace(1) %idx, ptr %idx_field, align 8
+  %r = call fastcc <4 x float> @read_record(ptr addrspace(1) %idx, ptr %ctx)
+  ret <4 x float> %r
+}
+
+define internal fastcc <4 x float> @read_record(ptr addrspace(1) %ix, ptr %ctx) {
+entry:
+  %field = getelementptr inbounds %Ctx, ptr %ctx, i64 0, i32 0
+  %records = load ptr addrspace(1), ptr %field, align 8
+  %i32 = load i32, ptr addrspace(1) %ix, align 4
+  %i = sext i32 %i32 to i64
+  %record = getelementptr inbounds %Seg, ptr addrspace(1) %records, i64 %i
+  %sum = call fastcc <4 x float> @sum_record(ptr addrspace(1) %record)
+  %first_a = getelementptr inbounds %Seg, ptr addrspace(1) %records, i64 0, i32 0
+  %a0 = load <4 x float>, ptr addrspace(1) %first_a, align 16
+  %r = fadd fast <4 x float> %sum, %a0
+  ret <4 x float> %r
+}
+
+define internal fastcc <4 x float> @sum_record(ptr addrspace(1) %record) {
+entry:
+  %a = load <4 x float>, ptr addrspace(1) %record, align 16
+  %b_field = getelementptr inbounds %Seg, ptr addrspace(1) %record, i64 0, i32 1
+  %b = load <4 x float>, ptr addrspace(1) %b_field, align 16
+  %r = fadd fast <4 x float> %a, %b
+  ret <4 x float> %r
+}
+
+!air.fragment = !{!0}
+!0 = !{ptr @frag, !1, !3}
+!1 = !{!2}
+!2 = !{!"air.render_target", i32 0, i32 0, !"air.arg_type_name", !"float4"}
+!3 = !{!4, !5, !7}
+!4 = !{i32 0, !"air.position", !"air.center", !"air.no_perspective", !"air.arg_type_name", !"float4", !"air.arg_name", !"position"}
+!5 = !{i32 1, !"air.buffer", !"air.location_index", i32 0, i32 1, !"air.read", !"air.address_space", i32 1, !"air.struct_type_info", !6, !"air.arg_type_size", i32 48, !"air.arg_type_align_size", i32 16, !"air.arg_type_name", !"Seg", !"air.arg_name", !"segs"}
+!6 = !{i32 0, i32 16, i32 0, !"float4", !"a", i32 16, i32 16, i32 0, !"float4", !"b", i32 32, i32 8, i32 0, !"float2", !"c"}
+!7 = !{i32 2, !"air.buffer", !"air.location_index", i32 1, i32 1, !"air.read", !"air.address_space", i32 1, !"air.arg_type_size", i32 4, !"air.arg_type_align_size", i32 4, !"air.arg_type_name", !"int", !"air.arg_name", !"idx"}
+"#;
+    let tmp = std::env::temp_dir().join(format!(
+        "metal2vulkan_context_field_record_array_{}",
+        std::process::id()
+    ));
+    let _ = std::fs::create_dir_all(&tmp);
+    let spv = crate::translate_sanitized_native(ll, Stage::Fragment, &tmp).expect("translate");
+    let asm = disassemble(&spv).expect("disassemble");
+    let module = load_bytes(&spv).expect("load spv");
+    let definition = |id: Word| {
+        module
+            .types_global_values
+            .iter()
+            .find(|instruction| instruction.result_id == Some(id))
+            .unwrap_or_else(|| panic!("%{id} is defined: {asm}"))
+    };
+    let operand_id = |instruction: &Instruction, index: usize| match instruction.operands.get(index) {
+        Some(Operand::IdRef(id)) => *id,
+        other => panic!("operand {index} of {instruction:?} is {other:?}: {asm}"),
+    };
+    let records = module
+        .annotations
+        .iter()
+        .find(|instruction| {
+            instruction.class.opcode == Op::Decorate
+                && instruction.operands.get(1) == Some(&Operand::Decoration(Decoration::Binding))
+                && instruction.operands.get(2) == Some(&Operand::LiteralBit32(0))
+        })
+        .map(|instruction| operand_id(instruction, 0))
+        .expect("the record buffer has binding 0");
+    let block = operand_id(definition(definition(records).result_type.unwrap()), 1);
+    let block = definition(block);
+    assert_eq!(block.class.opcode, Op::TypeStruct, "{asm}");
+    assert_eq!(block.operands.len(), 1, "the block wraps one runtime array: {asm}");
+    let array = operand_id(block, 0);
+    assert_eq!(

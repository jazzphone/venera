+        "the record buffer is an array of records: {asm}"
+    );
+    assert!(
+        module.annotations.iter().any(|instruction| {
+            instruction.class.opcode == Op::Decorate
+                && instruction.operands.first() == Some(&Operand::IdRef(array))
+                && instruction.operands.get(1) == Some(&Operand::Decoration(Decoration::ArrayStride))
+                && instruction.operands.get(2) == Some(&Operand::LiteralBit32(48))
+        }),
+        "a record is 48 bytes apart: {asm}"
+    );
+    let constants = module
+        .types_global_values
+        .iter()
+        .filter(|instruction| instruction.class.opcode == Op::Constant)
+        .filter_map(|instruction| instruction.result_id)
+        .collect::<HashSet<_>>();
+    assert!(
+        module
+            .all_inst_iter()
+            .filter(|instruction| matches!(
+                instruction.class.opcode,
+                Op::AccessChain | Op::InBoundsAccessChain
+            ))
+            .filter(|instruction| instruction.operands.first() == Some(&Operand::IdRef(records)))
+            .any(|instruction| {

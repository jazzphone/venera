+/// The record type of an untyped buffer the body steps through by a run-time element index: the one pointee of the
+/// single-index access chains on it whose index is not a constant (`getelementptr %Record, ptr %buffer, i64 %i` reaches
+/// the entry as such a chain once the buffer's address is forwarded out of a local object's field, as from a context
+/// struct of buffer pointers a helper reads). The buffer is then an array of that record, whatever member paths the
+/// body also reads through element 0 (`getelementptr %Record, ptr %buffer, i64 0, i32 0` arrives as the one-index chain
+/// `0` to the member, so it names a member's type, not a second element type). None unless every such chain names the
+/// same aggregate.
+pub(in crate::passes) fn body_buf_dynamic_record_element_type(
+    ctx: &Ctx,
+    func: &Function,
+    pid: Word,
+) -> Option<Word> {
+    let defs = type_defs(&ctx.module);
+    let aliases = buffer_pointer_aliases(func, pid);
+    let mut element = None;
+    for instruction in func.blocks.iter().flat_map(|block| &block.instructions) {
+        if !matches!(
+            instruction.class.opcode,
+            Op::AccessChain
+                | Op::InBoundsAccessChain
+                | Op::PtrAccessChain
+                | Op::InBoundsPtrAccessChain
+        ) || !instruction
+            .operands
+            .first()
+            .is_some_and(|operand| matches!(operand, Operand::IdRef(id) if aliases.contains(id)))
+        {
+            continue;
+        }
+        let [_, Operand::IdRef(index)] = instruction.operands.as_slice() else {
+            continue;
+        };
+        if const_int_literal(&defs, *index).is_some() {
+            continue;
+        }
+        let pointee = instruction
+            .result_type
+            .and_then(|ty| ptr_pointee(&defs, ty))?;
+        if !defs.get(&pointee).is_some_and(|definition| {
+            matches!(definition.class.opcode, Op::TypeStruct | Op::TypeArray)
+        }) {
+            return None;
+        }
+        if element.is_some_and(|known| known != pointee) {
+            return None;
+        }
+        element = Some(pointee);
+    }
+    element
+}

From 9d19f14a3ddc5f0ee1c1f036b7d4c2f4abd86746 Mon Sep 17 00:00:00 2001
From: jazzphone <4240091+jazzphone@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:35:37 -0500
Subject: [PATCH 1/3] meson: build src/virtio for the virtio Vulkan driver
 without KMS/DRM

src/virtio was only entered when the target has KMS/DRM or virgl, and
vdrm (a Linux DRM helper library) came along with it. Enter src/virtio
whenever the Venus driver is requested; keep vdrm Linux-only.
---
 src/meson.build        | 2 +-
 src/virtio/meson.build | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/meson.build b/src/meson.build
index 80486ba..eeeb3d4 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -69,7 +69,7 @@ endif
 if with_any_intel
   subdir('intel')
 endif
-if system_has_kms_drm or with_gallium_virgl
+if system_has_kms_drm or with_gallium_virgl or with_virtio_vk
   subdir('virtio')
 endif
 if with_gallium_radeonsi or with_amd_vk or with_gallium_r300 or with_gallium_r600
diff --git a/src/virtio/meson.build b/src/virtio/meson.build
index bc5574c..d6d933c 100644
--- a/src/virtio/meson.build
+++ b/src/virtio/meson.build
@@ -7,4 +7,6 @@ inc_virtio_vdrm = include_directories('./vdrm')
 if with_virtio_vk
   subdir('vulkan')
 endif
-subdir('vdrm')
+if system_has_kms_drm or with_gallium_virgl
+  subdir('vdrm')
+endif

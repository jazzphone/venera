+static VkResult
+virtgpu_wait(struct vn_renderer *renderer,
+             const struct vn_renderer_wait *wait)
+{
+   struct virtgpu *gpu = (struct virtgpu *)renderer;
+
+   const int ret = sim_syncobj_wait(gpu, wait, false);
+   if (ret && errno != ETIME)
+      return VK_ERROR_DEVICE_LOST;
+
+   return ret ? VK_TIMEOUT : VK_SUCCESS;
+}
+
+static VkResult
+virtgpu_submit(struct vn_renderer *renderer,
+               const struct vn_renderer_submit *submit)
+{
+   struct virtgpu *gpu = (struct virtgpu *)renderer;
+
+   const int ret = sim_submit(gpu, submit);
+   return ret ? VK_ERROR_DEVICE_LOST : VK_SUCCESS;
+}
+
+static VkResult
+virtgpu_init_renderer_info(struct virtgpu *gpu)
+{
+   struct vn_renderer_info *info = &gpu->base.info;
+
+   info->drm.props = (VkPhysicalDeviceDrmPropertiesEXT){
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT,
+      .hasPrimary = false,
+      .hasRender = false,
+   };
+
+   info->pci.vendor_id = gpu->pci_vendor;
+   info->pci.device_id = gpu->pci_device;
+   info->pci.has_bus_info = false;
+
+   info->has_dma_buf_import = false;
+   info->has_external_sync = false;
+
+   info->has_implicit_fencing = false;
+
+   const struct virgl_renderer_capset_venus *capset = &gpu->capset.data;
+   info->wire_format_version = capset->wire_format_version;
+   info->vk_xml_version = capset->vk_xml_version;
+   info->vk_ext_command_serialization_spec_version =
+      capset->vk_ext_command_serialization_spec_version;
+   info->vk_mesa_venus_protocol_spec_version =
+      capset->vk_mesa_venus_protocol_spec_version;
+
+   /* The capset may be shorter than this Mesa's (a host with older fields
+    * only): a missing field reads 0.  A field the host did send as 0 is
+    * fatal, as in virtgpu; a missing one is only logged.
+    */
+   if (!CAPSET_HAS(gpu, supports_blob_id_0)) {
+      vn_log(gpu->instance, "capset lacks supports_blob_id_0 (%zu bytes)",
+             gpu->capset.size);
+   } else if (!capset->supports_blob_id_0) {
+      vn_log(gpu->instance, "host does not support blob_id 0 shmem");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   /* ensure vk_extension_mask is large enough to hold all capset masks */
+   STATIC_ASSERT(sizeof(info->vk_extension_mask) >=
+                 sizeof(capset->vk_extension_mask1));
+   memcpy(info->vk_extension_mask, capset->vk_extension_mask1,
+          sizeof(capset->vk_extension_mask1));
+
+   if (!CAPSET_HAS(gpu, allow_vk_wait_syncs)) {
+      vn_log(gpu->instance, "capset lacks allow_vk_wait_syncs (%zu bytes)",
+             gpu->capset.size);
+   } else if (!capset->allow_vk_wait_syncs) {
+      vn_log(gpu->instance, "host does not allow vk wait syncs");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   if (!CAPSET_HAS(gpu, supports_multiple_timelines)) {
+      vn_log(gpu->instance,
+             "capset lacks supports_multiple_timelines (%zu bytes)",
+             gpu->capset.size);
+   } else if (!capset->supports_multiple_timelines) {
+      vn_log(gpu->instance, "host does not support multiple timelines");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   info->max_timeline_count = gpu->max_timeline_count;
+
+   /* Use guest blob allocations from dedicated heap (Host visible memory) */
+   if (gpu->bo_blob_mem == VGPU_BLOB_MEM_HOST3D &&
+       CAPSET_HAS(gpu, use_guest_vram) && capset->use_guest_vram)
+      info->has_guest_vram = true;
+
+   return VK_SUCCESS;
+}
+
+static void
+virtgpu_destroy(struct vn_renderer *renderer,
+                const VkAllocationCallbacks *alloc)
+{
+   struct virtgpu *gpu = (struct virtgpu *)renderer;
+
+   vn_renderer_shmem_cache_fini(&gpu->shmem_cache);
+
+   if (gpu->conn != IO_OBJECT_NULL)
+      IOServiceClose(gpu->conn);
+
+   mtx_destroy(&gpu->dma_buf_import_mutex);
+
+   util_sparse_array_finish(&gpu->shmem_array);
+   util_sparse_array_finish(&gpu->bo_array);
+
+   vk_free(alloc, gpu);
+}
+
+static VkResult
+virtgpu_init_context(struct virtgpu *gpu)
+{
+   assert(!gpu->capset.version);
+   const int ret = virtgpu_ioctl_context_init(gpu, gpu->capset.id);
+   if (ret) {
+      vn_log(gpu->instance, "failed to initialize the Venus context");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+virtgpu_init_capset(struct virtgpu *gpu, size_t max_size)
+{
+   gpu->capset.id = VIRGL_RENDERER_CAPSET_VENUS;
+   gpu->capset.version = 0;
+
+   /* ask with room for the host's whole capset, whichever is larger */
+   size_t size = MAX2(max_size, sizeof(gpu->capset.data));
+   void *buf = calloc(1, size);
+   if (!buf)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   const int ret = virtgpu_ioctl_get_caps(gpu, gpu->capset.id,
+                                          gpu->capset.version, buf, &size);
+   if (ret) {
+      vn_log(gpu->instance, "failed to get venus v%d capset",
+             gpu->capset.version);
+      free(buf);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   gpu->capset.size = MIN2(size, sizeof(gpu->capset.data));
+   memcpy(&gpu->capset.data, buf, gpu->capset.size);
+   free(buf);
+
+   if (gpu->capset.data.wire_format_version == 0) {
+      vn_log(gpu->instance, "Unsupported wire format version %u",
+             gpu->capset.data.wire_format_version);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   if (VN_DEBUG(INIT))
+      vn_log(gpu->instance, "venus capset: %zu bytes", size);
+
+   return VK_SUCCESS;
+}
+
+/* open the kext's user client, check what the host offers */
+static VkResult
+virtgpu_open(struct virtgpu *gpu, size_t *venus_capset_size)
+{
+   io_service_t service = IOServiceGetMatchingService(
+      kIOMainPortDefault, IOServiceMatching(kVGUCServiceClass));
+   if (service == IO_OBJECT_NULL) {
+      /* the usual answer outside a VM, so quiet unless asked */
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "no %s service", kVGUCServiceClass);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   const kern_return_t kr =
+      IOServiceOpen(service, mach_task_self(), 0, &gpu->conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS) {
+      gpu->conn = IO_OBJECT_NULL;
+      vn_log(gpu->instance, "failed to open %s: 0x%x", kVGUCServiceClass, kr);
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   struct vgpu_info vinfo;
+   size_t vinfo_size = sizeof(vinfo);
+   memset(&vinfo, 0, sizeof(vinfo));
+   if (IOConnectCallStructMethod(gpu->conn, kVGUCGetInfo, NULL, 0, &vinfo,
+                                 &vinfo_size) != KERN_SUCCESS) {
+      vn_log(gpu->instance, "VirtioGPU GetInfo failed");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   bool has_venus = false;
+   const uint32_t n = MIN2(vinfo.num_capsets, VGPU_MAX_CAPSETS);
+   for (uint32_t i = 0; i < n; i++) {
+      if (vinfo.capset_id[i] == VGPU_CAPSET_VENUS) {
+         has_venus = true;
+         *venus_capset_size = vinfo.capset_max_size[i];
+      }
+   }
+   if (!has_venus) {
+      vn_log(gpu->instance, "the host has no Venus capset");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+   if (!vinfo.hostmem_size) {
+      vn_log(gpu->instance, "the host has no host-visible memory window");
+      return VK_ERROR_INITIALIZATION_FAILED;
+   }
+
+   gpu->pci_vendor = vinfo.pci_vendor ? vinfo.pci_vendor
+                                      : VIRTGPU_PCI_VENDOR_ID;
+   gpu->pci_device = vinfo.pci_device ? vinfo.pci_device
+                                      : VIRTGPU_PCI_DEVICE_ID;
+
+   /* host-visible memory is blob_mem HOST3D */
+   gpu->bo_blob_mem = VGPU_BLOB_MEM_HOST3D;
+   /* implied by the context's ring count */
+   gpu->max_timeline_count = VGPU_MAX_RINGS;
+
+   if (VN_DEBUG(INIT))
+      vn_log(gpu->instance, "using %s: %llu MB host memory, pci %04x:%04x",
+             kVGUCServiceClass, (unsigned long long)(vinfo.hostmem_size >> 20),
+             gpu->pci_vendor, gpu->pci_device);
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+virtgpu_init(struct virtgpu *gpu)
+{
+   util_sparse_array_init(&gpu->shmem_array, sizeof(struct virtgpu_shmem),
+                          1024);
+   util_sparse_array_init(&gpu->bo_array, sizeof(struct virtgpu_bo), 1024);
+
+   mtx_init(&gpu->dma_buf_import_mutex, mtx_plain);
+
+   size_t capset_size = 0;
+   VkResult result = virtgpu_open(gpu, &capset_size);
+   if (result == VK_SUCCESS)
+      result = virtgpu_init_capset(gpu, capset_size);
+   if (result == VK_SUCCESS)
+      result = virtgpu_init_context(gpu);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* a Venus shmem is a HOST3D blob with blob_id 0 */
+   gpu->shmem_blob_mem = VGPU_BLOB_MEM_HOST3D;
+
+   result = virtgpu_init_renderer_info(gpu);
+   if (result != VK_SUCCESS)
+      return result;
+
+   vn_renderer_shmem_cache_init(&gpu->shmem_cache, &gpu->base,
+                                virtgpu_shmem_destroy_now);
+
+   gpu->base.ops.destroy = virtgpu_destroy;
+   gpu->base.ops.submit = virtgpu_submit;
+   gpu->base.ops.wait = virtgpu_wait;
+
+   gpu->base.shmem_ops.create = virtgpu_shmem_create;
+   gpu->base.shmem_ops.destroy = virtgpu_shmem_destroy;
+
+   gpu->base.bo_ops.create_from_device_memory =
+      virtgpu_bo_create_from_device_memory;

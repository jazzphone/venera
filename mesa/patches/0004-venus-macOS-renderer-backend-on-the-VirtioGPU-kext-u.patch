diff --git a/src/virtio/vulkan/vn_renderer_macos.c b/src/virtio/vulkan/vn_renderer_macos.c
index b32d720..b59b27e 100644
--- a/src/virtio/vulkan/vn_renderer_macos.c
+++ b/src/virtio/vulkan/vn_renderer_macos.c
@@ -1,30 +1,1239 @@
 /*
  * SPDX-License-Identifier: MIT
  *
- * macOS backend for Venus.  This is a placeholder: the real backend talks
- * to a virtio-gpu kernel extension through a user client instead of Linux
- * DRM ioctls.  Until it exists, creating the renderer fails cleanly so that
- * vkCreateInstance returns VK_ERROR_INITIALIZATION_FAILED.
+ * macOS backend for Venus.  It is vn_renderer_virtgpu.c (Mesa 25.0.7) with
+ * the Linux DRM layer replaced by the user client of VirtioGPU.kext (see
+ * VirtioGPUUserAPI.h):
  *
- * To implement: fill in struct vn_renderer (info, ops, shmem_ops, bo_ops,
- * sync_ops, see vn_renderer.h) and return it from vn_renderer_create_macos.
+ *  - the device "fd" is an io_connect_t (IOServiceOpen on class "VirtioGPU");
+ *  - GEM handles are the kext's resource ids, mapped with MapBlob +
+ *    IOConnectMapMemory64 instead of DRM_IOCTL_VIRTGPU_MAP + mmap;
+ *  - execbuffer is kVGUCSubmit, whose fence is a per-ring counter;
+ *  - the simulated syncobjs (SIMULATE_SYNCOBJ) keep a pending (ring, fence)
+ *    pair instead of a sync_file fd, and poll() on it is kVGUCWaitFence;
+ *  - there are no dma-bufs and no exportable syncs.
  */
 
-#include "vn_renderer.h"
+#include <errno.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
 
-#include "vn_common.h"
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+
+#include "util/sparse_array.h"
+#define VIRGL_RENDERER_UNSTABLE_APIS
+#include "virtio-gpu/virglrenderer_hw.h"
+
+#include "VirtioGPUUserAPI.h"
+#include "vn_renderer_internal.h"
+
+/* kept from virtgpu: sims, not kernel syncobjs */
+#define SIMULATE_BO_SIZE_FIX 1
+#define SIMULATE_SYNCOBJ     1
+#define SIMULATE_SUBMIT      1
+
+#define VIRTGPU_PCI_VENDOR_ID 0x1af4
+#define VIRTGPU_PCI_DEVICE_ID 0x1050
+
+/* the longest single kVGUCWaitFence; longer waits are looped */
+#define VGPU_WAIT_CHUNK_MS 1000
+
+struct virtgpu;
+
+struct virtgpu_shmem {
+   struct vn_renderer_shmem base;
+   uint32_t gem_handle; /* resource id of the kext */
+};
+
+struct virtgpu_bo {
+   struct vn_renderer_bo base;
+   uint32_t gem_handle; /* resource id of the kext */
+   uint32_t blob_flags;
+};
+
+struct virtgpu_sync {
+   struct vn_renderer_sync base;
+
+   /* handle of the simulated syncobj (see sim_syncobj below) */
+   uint32_t syncobj_handle;
+};
+
+struct virtgpu {
+   struct vn_renderer base;
+
+   struct vn_instance *instance;
+
+   io_connect_t conn;
+
+   uint32_t pci_vendor;
+   uint32_t pci_device;
+
+   uint32_t max_timeline_count;
+
+   struct {
+      enum virgl_renderer_capset id;
+      uint32_t version;
+      /* bytes the kext returned (fields past it read as 0) */
+      size_t size;
+      struct virgl_renderer_capset_venus data;
+   } capset;
+
+   uint32_t shmem_blob_mem;
+   uint32_t bo_blob_mem;
+
+   /* indexed by the kext's resource id */
+   struct util_sparse_array shmem_array;
+   struct util_sparse_array bo_array;
+
+   mtx_t dma_buf_import_mutex;
+
+   struct vn_renderer_shmem_cache shmem_cache;
+};
+
+/* does the capset the kext returned reach up to and including a field? */
+#define CAPSET_HAS(gpu, field)                                               \
+   ((gpu)->capset.size >= offsetof(struct virgl_renderer_capset_venus, field) + \
+                             sizeof((gpu)->capset.data.field))
+
+/*
+ * IOKit calls (the virtgpu_ioctl_* layer)
+ */
+
+static bool
+vgpu_call(struct virtgpu *gpu,
+          uint32_t selector,
+          const uint64_t *in,
+          uint32_t in_count,
+          uint64_t *out,
+          uint32_t out_count)
+{
+   uint32_t n = out_count;
+   const kern_return_t kr = IOConnectCallScalarMethod(
+      gpu->conn, selector, in, in_count, out, out_count ? &n : NULL);
+   if (kr != KERN_SUCCESS) {
+      if (VN_DEBUG(INIT))
+         vn_log(gpu->instance, "VirtioGPU method %u failed: 0x%x", selector,
+                kr);
+      return false;
+   }
+   return true;
+}
+
+static int
+virtgpu_ioctl_get_caps(struct virtgpu *gpu,
+                       enum virgl_renderer_capset id,
+                       uint32_t version,
+                       void *capset,
+                       size_t *capset_size)
+{
+   const uint64_t in[2] = { id, version };
+   const kern_return_t kr =
+      IOConnectCallMethod(gpu->conn, kVGUCGetCapset, in, 2, NULL, 0, NULL,
+                          NULL, capset, capset_size);
+   return kr == KERN_SUCCESS ? 0 : -1;
+}
+
+static int
+virtgpu_ioctl_context_init(struct virtgpu *gpu,
+                           enum virgl_renderer_capset capset_id)
+{
+   const uint64_t in[1] = { capset_id };
+   uint64_t ctx_id = 0;
+   return vgpu_call(gpu, kVGUCContextInit, in, 1, &ctx_id, 1) ? 0 : -1;
+}
+
+/* returns the resource id (used as the "gem handle"), or 0 */
+static uint32_t
+virtgpu_ioctl_resource_create_blob(struct virtgpu *gpu,
+                                   uint32_t blob_mem,
+                                   uint32_t blob_flags,
+                                   size_t blob_size,
+                                   uint64_t blob_id)
+{
+#ifdef SIMULATE_BO_SIZE_FIX
+   blob_size = align64(blob_size, 4096);
+#endif
+
+   const uint64_t in[4] = { blob_mem, blob_flags, blob_size, blob_id };
+   uint64_t res_id = 0;
+   if (!vgpu_call(gpu, kVGUCCreateBlob, in, 4, &res_id, 1))
+      return 0;
+
+   return (uint32_t)res_id;
+}
+
+static void
+virtgpu_ioctl_gem_close(struct virtgpu *gpu, uint32_t gem_handle)
+{
+   const uint64_t in[1] = { gem_handle };
+   vgpu_call(gpu, kVGUCDestroyResource, in, 1, NULL, 0);
+}
+
+static void *
+virtgpu_ioctl_map(struct virtgpu *gpu, uint32_t gem_handle, size_t size)
+{
+   const uint64_t in[1] = { gem_handle };
+   uint64_t out[2] = { 0, 0 };
+   if (!vgpu_call(gpu, kVGUCMapBlob, in, 1, out, 2))
+      return NULL;
+
+   mach_vm_address_t addr = 0;
+   mach_vm_size_t mapped = 0;
+   const kern_return_t kr =
+      IOConnectMapMemory64(gpu->conn, gem_handle, mach_task_self(), &addr,
+                           &mapped, kIOMapAnywhere);
+   if (kr != KERN_SUCCESS || !addr) {
+      vn_log(gpu->instance, "failed to map resource %u: 0x%x", gem_handle,
+             kr);
+      return NULL;
+   }
+
+   if (mapped < size) {
+      vn_log(gpu->instance, "resource %u mapped %llu bytes, wanted %zu",
+             gem_handle, (unsigned long long)mapped, size);
+      IOConnectUnmapMemory64(gpu->conn, gem_handle, mach_task_self(), addr);
+      return NULL;
+   }
+
+   return (void *)(uintptr_t)addr;
+}
+
+static void
+virtgpu_unmap(struct virtgpu *gpu, uint32_t gem_handle, void *ptr)
+{
+   IOConnectUnmapMemory64(gpu->conn, gem_handle, mach_task_self(),
+                          (mach_vm_address_t)(uintptr_t)ptr);
+}
+
+/* returns false on failure; *fence is the ring's new fence (0 if none) */
+static bool
+vgpu_exec(struct virtgpu *gpu,
+          uint32_t ring_idx,
+          const void *cs,
+          size_t cs_size,
+          bool want_fence,
+          uint64_t *fence)
+{
+   const uint64_t in[2] = { ring_idx, want_fence ? 1 : 0 };
+   uint64_t out = 0;
+   uint32_t out_count = 1;
+
+   const kern_return_t kr =
+      IOConnectCallMethod(gpu->conn, kVGUCSubmit, in, 2, cs_size ? cs : NULL,
+                          cs_size, &out, &out_count, NULL, NULL);
+   if (kr != KERN_SUCCESS) {
+      vn_log(gpu->instance, "failed to submit to ring %u: 0x%x", ring_idx,
+             kr);
+      return false;
+   }
+
+   if (want_fence && !out) {
+      vn_log(gpu->instance, "submit to ring %u returned no fence", ring_idx);
+      return false;
+   }
+
+   *fence = out;
+   return true;
+}
+
+/* 1 signaled, 0 not yet, -1 error; timeout_ns 0 polls */
+static int
+vgpu_wait_fence(struct virtgpu *gpu,
+                uint32_t ring_idx,
+                uint64_t fence,
+                uint64_t timeout_ns)
+{
+   const uint64_t in[3] = { ring_idx, fence, timeout_ns };
+   uint64_t out = 0;
+   if (!vgpu_call(gpu, kVGUCWaitFence, in, 3, &out, 1))
+      return -1;
+   return out ? 1 : 0;
+}
+
+#ifdef SIMULATE_SYNCOBJ
+
+#include "util/hash_table.h"
+#include "util/u_idalloc.h"
+
+static struct {
+   once_flag once;
+   bool ok;
+
+   mtx_t mutex;
+   struct hash_table *syncobjs;
+   struct util_idalloc ida;
+} sim = { .once = ONCE_FLAG_INIT };
+
+struct sim_syncobj {
+   mtx_t mutex;
+   uint64_t point;
+
+   /* a pending point is signaled by (pending_ring, pending_fence) */
+   bool has_pending;
+   uint32_t pending_ring;
+   uint64_t pending_fence;
+   uint64_t pending_point;
+   bool pending_cpu;
+};
+
+static void
+sim_init_once(void)
+{
+   /* a zeroed mtx_t is not a valid mutex on macOS, so init lazily */
+   mtx_init(&sim.mutex, mtx_plain);
+   sim.syncobjs = _mesa_pointer_hash_table_create(NULL);
+   if (!sim.syncobjs)
+      return;
+   util_idalloc_init(&sim.ida, 32);
+   sim.ok = true;
+}
+
+static uint32_t
+sim_syncobj_create(struct virtgpu *gpu, bool signaled)
+{
+   call_once(&sim.once, sim_init_once);
+   if (!sim.ok)
+      return 0;
+
+   struct sim_syncobj *syncobj = calloc(1, sizeof(*syncobj));
+   if (!syncobj)
+      return 0;
+
+   mtx_init(&syncobj->mutex, mtx_plain);
+
+   mtx_lock(&sim.mutex);
+   const unsigned syncobj_handle = util_idalloc_alloc(&sim.ida) + 1;
+   _mesa_hash_table_insert(sim.syncobjs,
+                           (const void *)(uintptr_t)syncobj_handle, syncobj);
+   mtx_unlock(&sim.mutex);
+
+   return syncobj_handle;
+}
+
+static void
+sim_syncobj_destroy(struct virtgpu *gpu, uint32_t syncobj_handle)
+{
+   struct sim_syncobj *syncobj = NULL;
+
+   mtx_lock(&sim.mutex);
+
+   struct hash_entry *entry = _mesa_hash_table_search(
+      sim.syncobjs, (const void *)(uintptr_t)syncobj_handle);
+   if (entry) {
+      syncobj = entry->data;
+      _mesa_hash_table_remove(sim.syncobjs, entry);
+      util_idalloc_free(&sim.ida, syncobj_handle - 1);
+   }
+
+   mtx_unlock(&sim.mutex);
+
+   if (syncobj) {
+      mtx_destroy(&syncobj->mutex);
+      free(syncobj);
+   }
+}
+
+/* kVGUCWaitFence with virtgpu's poll() timeout: ms, -1 infinite, 0 poll */
+static VkResult
+sim_syncobj_poll(struct virtgpu *gpu,
+                 uint32_t ring_idx,
+                 uint64_t fence,
+                 int poll_timeout)
+{
+   if (!poll_timeout) {
+      const int ret = vgpu_wait_fence(gpu, ring_idx, fence, 0);
+      if (ret < 0)
+         return VK_ERROR_DEVICE_LOST;
+      return ret ? VK_SUCCESS : VK_TIMEOUT;
+   }
+
+   int64_t remaining = poll_timeout; /* < 0: forever */
+   for (;;) {
+      int64_t chunk = VGPU_WAIT_CHUNK_MS;
+      if (remaining >= 0 && remaining < chunk)
+         chunk = remaining;
+
+      const int ret =
+         vgpu_wait_fence(gpu, ring_idx, fence, (uint64_t)chunk * 1000000);
+      if (ret < 0)
+         return VK_ERROR_DEVICE_LOST;
+      if (ret)
+         return VK_SUCCESS;
+
+      if (remaining >= 0) {
+         remaining -= chunk;
+         if (remaining <= 0)
+            return VK_TIMEOUT;
+      }
+   }
+}
+
+static void
+sim_syncobj_set_point_locked(struct sim_syncobj *syncobj, uint64_t point)
+{
+   syncobj->point = point;
+
+   if (syncobj->has_pending) {
+      syncobj->has_pending = false;
+      syncobj->pending_point = point;
+   }
+}
+
+static VkResult
+sim_syncobj_update_point_locked(struct virtgpu *gpu,
+                                struct sim_syncobj *syncobj,
+                                int poll_timeout)
+{
+   VkResult result = VK_SUCCESS;
+
+   if (syncobj->has_pending) {
+      if (syncobj->pending_cpu && poll_timeout == -1) {
+         const int max_cpu_timeout = 2000;
+         poll_timeout = max_cpu_timeout;
+         result = sim_syncobj_poll(gpu, syncobj->pending_ring,
+                                   syncobj->pending_fence, poll_timeout);
+         if (result == VK_TIMEOUT) {
+            vn_log(NULL, "cpu sync timed out after %dms; ignoring",
+                   poll_timeout);
+            result = VK_SUCCESS;
+         }
+      } else {
+         result = sim_syncobj_poll(gpu, syncobj->pending_ring,
+                                   syncobj->pending_fence, poll_timeout);
+      }
+      if (result == VK_SUCCESS) {
+         syncobj->has_pending = false;
+         syncobj->point = syncobj->pending_point;
+      }
+   }
+
+   return result;
+}
+
+static struct sim_syncobj *
+sim_syncobj_lookup(struct virtgpu *gpu, uint32_t syncobj_handle)
+{
+   struct sim_syncobj *syncobj = NULL;
+
+   mtx_lock(&sim.mutex);
+   struct hash_entry *entry = _mesa_hash_table_search(
+      sim.syncobjs, (const void *)(uintptr_t)syncobj_handle);
+   if (entry)
+      syncobj = entry->data;
+   mtx_unlock(&sim.mutex);
+
+   return syncobj;
+}
+
+static int
+sim_syncobj_reset(struct virtgpu *gpu, uint32_t syncobj_handle)
+{
+   struct sim_syncobj *syncobj = sim_syncobj_lookup(gpu, syncobj_handle);
+   if (!syncobj)
+      return -1;
+
+   mtx_lock(&syncobj->mutex);
+   sim_syncobj_set_point_locked(syncobj, 0);
+   mtx_unlock(&syncobj->mutex);
+
+   return 0;
+}
+
+static int
+sim_syncobj_query(struct virtgpu *gpu,
+                  uint32_t syncobj_handle,
+                  uint64_t *point)
+{
+   struct sim_syncobj *syncobj = sim_syncobj_lookup(gpu, syncobj_handle);
+   if (!syncobj)
+      return -1;
+
+   mtx_lock(&syncobj->mutex);
+   sim_syncobj_update_point_locked(gpu, syncobj, 0);
+   *point = syncobj->point;
+   mtx_unlock(&syncobj->mutex);
+
+   return 0;
+}
+
+static int
+sim_syncobj_signal(struct virtgpu *gpu,
+                   uint32_t syncobj_handle,
+                   uint64_t point)
+{
+   struct sim_syncobj *syncobj = sim_syncobj_lookup(gpu, syncobj_handle);
+   if (!syncobj)
+      return -1;
+
+   mtx_lock(&syncobj->mutex);
+   sim_syncobj_set_point_locked(syncobj, point);
+   mtx_unlock(&syncobj->mutex);
+
+   return 0;
+}
+
+static int
+sim_syncobj_submit(struct virtgpu *gpu,
+                   uint32_t syncobj_handle,
+                   uint32_t ring_idx,
+                   uint64_t fence,
+                   uint64_t point,
+                   bool cpu)
+{
+   struct sim_syncobj *syncobj = sim_syncobj_lookup(gpu, syncobj_handle);
+   if (!syncobj)
+      return -1;
+
+   mtx_lock(&syncobj->mutex);
+
+   if (syncobj->has_pending) {
+      mtx_unlock(&syncobj->mutex);
+
+      /* TODO */
+      vn_log(gpu->instance, "sorry, no simulated timeline semaphore");
+      return -1;
+   }
+   if (syncobj->point >= point)
+      vn_log(gpu->instance, "non-monotonic signaling");
+
+   syncobj->has_pending = true;
+   syncobj->pending_ring = ring_idx;
+   syncobj->pending_fence = fence;
+   syncobj->pending_point = point;
+   syncobj->pending_cpu = cpu;
+
+   mtx_unlock(&syncobj->mutex);
+
+   return 0;
+}
+
+static int
+timeout_to_poll_timeout(uint64_t timeout)
+{
+   const uint64_t ns_per_ms = 1000000;
+   const uint64_t ms = (timeout + ns_per_ms - 1) / ns_per_ms;
+   if (!ms && timeout)
+      return -1;
+   return ms <= INT_MAX ? ms : -1;
+}
+
+static int
+sim_syncobj_wait(struct virtgpu *gpu,
+                 const struct vn_renderer_wait *wait,
+                 bool wait_avail)
+{
+   if (wait_avail)
+      return -1;
+
+   const int poll_timeout = timeout_to_poll_timeout(wait->timeout);
+
+   /* TODO poll all fences at the same time */
+   for (uint32_t i = 0; i < wait->sync_count; i++) {
+      struct virtgpu_sync *sync = (struct virtgpu_sync *)wait->syncs[i];
+      const uint64_t point = wait->sync_values[i];
+
+      struct sim_syncobj *syncobj =
+         sim_syncobj_lookup(gpu, sync->syncobj_handle);
+      if (!syncobj)
+         return -1;
+
+      mtx_lock(&syncobj->mutex);
+
+      if (syncobj->point < point) {
+         const VkResult result =
+            sim_syncobj_update_point_locked(gpu, syncobj, poll_timeout);
+         if (result != VK_SUCCESS && result != VK_TIMEOUT) {
+            mtx_unlock(&syncobj->mutex);
+            errno = EIO;
+            return -1;
+         }
+      }
+
+      if (syncobj->point < point) {
+         if (wait->wait_any && i < wait->sync_count - 1 &&
+             !syncobj->has_pending) {
+            mtx_unlock(&syncobj->mutex);
+            continue;
+         }
+         errno = ETIME;
+         mtx_unlock(&syncobj->mutex);
+         return -1;
+      }
+
+      mtx_unlock(&syncobj->mutex);
+
+      if (wait->wait_any)
+         break;
+
+      /* TODO adjust poll_timeout */
+   }
+
+   return 0;
+}
+
+#endif /* SIMULATE_SYNCOBJ */
+
+#ifdef SIMULATE_SUBMIT
+
+static int
+sim_submit_signal_syncs(struct virtgpu *gpu,
+                        uint32_t ring_idx,
+                        uint64_t fence,
+                        struct vn_renderer_sync *const *syncs,
+                        const uint64_t *sync_values,
+                        uint32_t sync_count,
+                        bool cpu)
+{
+   for (uint32_t i = 0; i < sync_count; i++) {
+      struct virtgpu_sync *sync = (struct virtgpu_sync *)syncs[i];
+      const uint64_t pending_point = sync_values[i];
+
+      int ret = sim_syncobj_submit(gpu, sync->syncobj_handle, ring_idx,
+                                   fence, pending_point, cpu);
+      if (ret)
+         return ret;
+   }
+
+   return 0;
+}
+
+static int
+sim_submit(struct virtgpu *gpu, const struct vn_renderer_submit *submit)
+{
+   /* the kext keeps its resources alive; submit->bos need no pinning */
+   assert(submit->batch_count);
+
+   for (uint32_t i = 0; i < submit->batch_count; i++) {
+      const struct vn_renderer_submit_batch *batch = &submit->batches[i];
+
+      uint64_t fence = 0;
+      if (!vgpu_exec(gpu, batch->ring_idx, batch->cs_data, batch->cs_size,
+                     batch->sync_count > 0, &fence))
+         return -1;
+
+      if (batch->sync_count) {
+         const int ret = sim_submit_signal_syncs(
+            gpu, batch->ring_idx, fence, batch->syncs, batch->sync_values,
+            batch->sync_count, batch->ring_idx == 0);
+         if (ret)
+            return ret;
+      }
+   }
+
+   return 0;
+}
+
+#endif /* SIMULATE_SUBMIT */

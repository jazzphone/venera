+static void
+virtgpu_bo_invalidate(struct vn_renderer *renderer,
+                      struct vn_renderer_bo *bo,
+                      VkDeviceSize offset,
+                      VkDeviceSize size)
+{
+   /* nop: the mapping is as coherent as the host says (MapBlob map_info) */
+}

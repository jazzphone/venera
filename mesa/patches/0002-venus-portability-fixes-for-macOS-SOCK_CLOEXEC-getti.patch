From eca256c7ded2b3b20e021eabfd85036ad83f2209 Mon Sep 17 00:00:00 2001
From: jazzphone <4240091+jazzphone@users.noreply.github.com>
Date: Sun, 15 Nov 2026 11:35:37 -0500
Subject: [PATCH 2/4] venus: portability fixes for macOS (SOCK_CLOEXEC, gettid)

Darwin has no SOCK_CLOEXEC (use fcntl FD_CLOEXEC) and no SYS_gettid
(use pthread_threadid_np). vn_renderer_vtest.c otherwise builds as is.
---
 src/virtio/vulkan/vn_common.h         | 4 ++++
 src/virtio/vulkan/vn_renderer_vtest.c | 8 ++++++++
 2 files changed, 12 insertions(+)

diff --git a/src/virtio/vulkan/vn_common.h b/src/virtio/vulkan/vn_common.h
index 21cd82d..dac2f2b 100644
--- a/src/virtio/vulkan/vn_common.h
+++ b/src/virtio/vulkan/vn_common.h
@@ -554,6 +554,10 @@ vn_gettid(void)
 {
 #if DETECT_OS_ANDROID
    return gettid();
+#elif defined(__APPLE__)
+   uint64_t tid = 0;
+   pthread_threadid_np(NULL, &tid);
+   return (pid_t)tid;
 #else
    return syscall(SYS_gettid);
 #endif
diff --git a/src/virtio/vulkan/vn_renderer_vtest.c b/src/virtio/vulkan/vn_renderer_vtest.c
index d932ea8..9d7f23d 100644
--- a/src/virtio/vulkan/vn_renderer_vtest.c
+++ b/src/virtio/vulkan/vn_renderer_vtest.c
@@ -7,6 +7,7 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
 #include <netinet/in.h>
 #include <poll.h>
 #include <sys/mman.h>
@@ -77,11 +78,18 @@ vtest_connect_socket(struct vn_instance *instance, const char *path)
    struct sockaddr_un un;
    int sock;
 
+#ifdef SOCK_CLOEXEC
    sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+#else
+   sock = socket(AF_UNIX, SOCK_STREAM, 0);
+#endif
    if (sock < 0) {
       vn_log(instance, "failed to create a socket");
       return -1;
    }
+#ifndef SOCK_CLOEXEC
+   fcntl(sock, F_SETFD, FD_CLOEXEC);
+#endif
 
    memset(&un, 0, sizeof(un));
    un.sun_family = AF_UNIX;
